# ==============================================================================
# NILESH PARDHI PORTFOLIO - RESEND EMAIL API CONFIGURATION
# ==============================================================================
# 1. Sign up or log in at https://resend.com/
# 2. Generate an API Key under "API Keys" -> Set below (starts with "re_...")
# 3. For initial testing without a custom domain, you can use:
#    RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
#    (Note: Resend free tier sends to the account owner's email)
# 4. For production with a custom domain, verify your domain under "Domains"
#    and set: RESEND_FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>
# ==============================================================================

# Private Resend API Key (kept strictly on the server; never exposed to frontend)
RESEND_API_KEY=re_your_resend_api_key_here

# Recipient email address to receive incoming portfolio contact messages
CONTACT_EMAIL=nileshpardhi.analytics@gmail.com

# Authorized sender address in Resend
# Use "onboarding@resend.dev" for testing or your verified domain address for production
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Server Port (optional, used when running 'npm start' with Node.js)
PORT=3000
